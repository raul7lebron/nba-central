# Copia este archivo a ".env" y rellena tus claves.
# balldontlie: consiguela gratis registrandote en https://www.balldontlie.io
BALLDONTLIE_API_KEY=

# nba2kapi: consiguela gratis registrandote en https://www.nba2kapi.com
NBA2KAPI_KEY=

# Puerto en el que arranca el servidor local
PORT=3000

# Tu dominio real una vez publicada la web (para robots.txt/sitemap.xml).
# Sin esto, el sitemap apunta a un dominio de ejemplo que no sirve de nada.
SITE_URL=https://tudominio.com
