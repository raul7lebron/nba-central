# Copia este archivo a ".env" y rellena tus claves.
# balldontlie: consiguela gratis registrandote en https://www.balldontlie.io
BALLDONTLIE_API_KEY=

# nba2kapi: consiguela gratis registrandote en https://www.nba2kapi.com
NBA2KAPI_KEY=

# Puerto en el que arranca el servidor local
PORT=3000

# Tu dominio real una vez publicada la web (para robots.txt/sitemap.xml).
# Sin esto, el sitemap apunta a un dominio de ejemplo que no sirve de nada.
SITE_URL=https://tudominio.com

# --- Publicacion automatica de resultados finales (opcional) ---
# Si no rellenas ninguna de las dos secciones, la web funciona igual, solo
# que no publica nada: son canales independientes, puedes activar solo uno.

# Telegram: crea un bot gratis hablando con @BotFather en Telegram, te da el
# token. TELEGRAM_CHAT_ID es el @nombre_de_tu_canal (si es publico) o el id
# numerico del chat/canal (si es privado, consiguelo con @myidbot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X (Twitter): crea una app en https://developer.twitter.com con permisos de
# lectura Y escritura, genera las 4 claves (API key/secret + access
# token/secret del plan gratuito "Free").
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
